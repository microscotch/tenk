<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plein écran : le jeu se dessine aussi derrière l'encoche (ou le trou de la
         caméra) en portrait, au lieu de la laisser en bande noire quand les barres sont
         cachées. L'app lit les marges de l'encoche par SafeArea. API 28 et plus. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
