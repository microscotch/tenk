          </mxGeometry>
        </mxCell>

        <mxCell id="e-pending-ready-cont" value="applyKeepDecision :&#10;dés restants" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.3;entryX=1;entryY=0.7;" edge="1" parent="1" source="pending" target="ready">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="520" />
              <mxPoint x="840" y="230" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e-pending-busted" value="applyKeep : dépassement&#10;(filet, anciens journaux)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="pending" target="busted">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-ready-banked" value="tryBank réussit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ready" target="banked">
          <mxGeometry relative="1" as="geometry" />
