<mxfile host="app.diagrams.net" modified="2026-09-22T00:00:00.000Z" agent="Claude Code" version="24.0.0">
  <diagram name="État d'un tour" id="tenk-turn-state">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Pseudo-état de départ -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- États -->
        <mxCell id="ready" value="Prêt à lancer&#10;(diceToRoll dés disponibles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pending" value="Décision en attente&#10;(pendingRoll analysé)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="480" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="busted" value="Craqué&#10;(busted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="banked" value="Banqué&#10;(tour validé)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Fin de tour (sortie vers le moteur de partie) -->
        <mxCell id="end" value="fin du tour&#10;(GameEngine._advance,&#10;retour au moteur de partie)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="620" width="290" height="80" as="geometry" />
        </mxCell>

        <!-- Notes -->
        <mxCell id="note1" value="Règle d'extension : un brelan/carré banqué rend tout dé isolé de la même valeur ensuite gardé au tour = 100 pts (extendedValues). Totalement effacée dès des dés chauds — ne survit jamais à un jeu de 5 dés neufs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="480" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="Atteindre exactement 10000 en banquant contourne le minimum par tour et la règle du 50 — mais jamais pendant des dés chauds : la main pleine (mustContinue) oblige à relancer, et tryBank le teste en premier. Une main pleine pile sur 10000 est donc une impasse : craque dès le lancer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="270" width="290" height="150" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="Exception : la quinte d'as (5 as en un seul lancer) gagne sur-le-champ, même en main pleine — applyKeep banque sans passer par tryBank." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="290" height="90" as="geometry" />
        </mxCell>

        <!-- Arêtes -->
        <mxCell id="e-start-ready" value="début de tour" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="start" target="ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-ready-pending" value="roll : marque, et une issue existe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ready" target="pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-ready-busted" value="roll : aucun point" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="ready" target="busted">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-ready-busted-deadend" value="roll : impasse (dépassement de 10000,&#10;ou main pleine pile sur 10000)&#10;— craque dès le lancer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.05;entryX=0.3;entryY=0;" edge="1" parent="1" source="ready" target="busted">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1040" y="154" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e-pending-ready-hot" value="applyKeepDecision :&#10;dés chauds (relance forcée)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0;exitY=0.3;entryX=0;entryY=0.7;" edge="1" parent="1" source="pending" target="ready">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="520" />
              <mxPoint x="420" y="230" />
