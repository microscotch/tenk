        <mxCell id="e-busted-end" value="endBustedTurn&#10;(rien n'est gardé)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="busted" target="end">
          <mxGeometry relative="1" as="geometry">
