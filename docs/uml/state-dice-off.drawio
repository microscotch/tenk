<mxfile host="drawio"><diagram name="Page-1" id="d"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Machine à états — départage (DiceOffState)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1200" height="26" as="geometry"/></mxCell><mxCell id="t2" value="Un round = tous les joueurs encore en lice lancent un dé ensemble (rollAll), puis le round est tranché (resolveRound). Le résultat fixe qui commence et dans quel sens la partie tourne (playOrder)." style="text;html=1;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="34" width="1300" height="32" as="geometry"/></mxCell><mxCell id="i" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="24" height="24" as="geometry"/></mxCell><mxCell id="await" value="&lt;b&gt;En attente du round&lt;/b&gt;&lt;br/&gt;activeIndices = joueurs en lice&lt;br/&gt;rollsThisRound vide" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="155" width="230" height="74" as="geometry"/></mxCell><mxCell id="rolled" value="&lt;b&gt;Round lancé&lt;/b&gt;&lt;br/&gt;un dé par joueur en lice&lt;br/&gt;(roundComplete)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="155" width="230" height="74" as="geometry"/></mxCell><mxCell id="ch" value="plus petit&lt;br/&gt;dé ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="895" y="152" width="90" height="80" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;Résolu&lt;/b&gt;&lt;br/&gt;winnerIndex fixé&lt;br/&gt;activeIndices = dernier round" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="825" y="330" width="230" height="80" as="geometry"/></mxCell><mxCell id="ch2" value="dernier round :&lt;br/&gt;duel entre&lt;br/&gt;voisins ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="470" width="120" height="100" as="geometry"/></mxCell><mxCell id="rev" value="&lt;b&gt;Sens inversé&lt;/b&gt;&lt;br/&gt;reversesOrder = vrai&lt;br/&gt;vainqueur, puis vers le perdant" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1220" y="480" width="240" height="80" as="geometry"/></mxCell><mxCell id="fwd" value="&lt;b&gt;Sens de la liste&lt;/b&gt;&lt;br/&gt;vainqueur, puis les suivants&lt;br/&gt;de la liste (table circulaire)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="240" height="80" as="geometry"/></mxCell><mxCell id="f" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="925" y="670" width="30" height="30" as="geometry"/></mxCell><mxCell id="e1" value="start(n)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="i" target="await"><mxGeometry x="0" y="-12" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="rollAll(random)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="await" target="rolled"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="resolveRound()" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="rolled" target="ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="[plusieurs ex-aequo au plus bas]&lt;br/&gt;seuls eux restent en lice" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="ch" target="await"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="100"/><mxPoint x="315" y="100"/></Array></mxGeometry></mxCell><mxCell id="e5" value="[un seul]" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="ch" target="res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="playOrder" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="res" target="ch2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="[oui, et le vainqueur est le second&lt;br/&gt;dans l&#x27;ordre de la liste, N ≥ 3]" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="ch2" target="rev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="[sinon]" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="ch2" target="fwd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="buildOrderedSetup()" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="rev" target="f"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="685"/></Array></mxGeometry></mxCell><mxCell id="e10" value="buildOrderedSetup()" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="fwd" target="f"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="685"/></Array></mxGeometry></mxCell><mxCell id="n1" value="Exemple (5 joueurs) : J2 = J3 au plus bas, puis J3 gagne le duel&lt;br/&gt;→ ordre J3, J2, J1, J5, J4.&lt;br/&gt;Une égalité à trois tranchée d&#x27;un coup, ou un duel entre non-voisins,&lt;br/&gt;garde le sens de la liste. À deux joueurs, les deux sens se confondent." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#fff9c4;strokeColor=#b8a400;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="420" height="86" as="geometry"/></mxCell><mxCell id="n2" value="Ancien format (journal à diceOffRoll, un joueur à la fois) :&lt;br/&gt;simultaneous = faux → toujours le sens de la liste,&lt;br/&gt;pour qu&#x27;une partie archivée garde ses sièges au rejeu." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#fff9c4;strokeColor=#b8a400;" vertex="1" parent="1"><mxGeometry x="1080" y="750" width="360" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
