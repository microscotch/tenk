<mxfile host="drawio"><diagram name="Page-1" id="d"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Cas d&#x27;utilisation — TenK" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1200" height="26" as="geometry"/></mxCell><mxCell id="t2" value="Un seul acteur : la personne qui tient le téléphone. Plusieurs joueurs humains partagent le même appareil (« passez l&#x27;appareil ») ou jouent en ligne, chacun sur le sien ; les bots font partie du système, ce ne sont pas des acteurs." style="text;html=1;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="34" width="1250" height="32" as="geometry"/></mxCell><mxCell id="sys" value="TenK (Le 10000)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=top;fillColor=#fafafa;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="75" width="980" height="800" as="geometry"/></mxCell><mxCell id="J" value="Joueur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="400" width="36" height="64" as="geometry"/></mxCell><mxCell id="u1" value="Gérer les fiches joueurs&lt;br/&gt;(nom, surnom, latéralité)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="105" width="270" height="62" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="J" target="u1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u2" value="Composer une nouvelle partie&lt;br/&gt;(humains, bots, mode auto,&lt;br/&gt;ordre autour de la table)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="177" width="270" height="62" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="J" target="u2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u4" value="Jouer un tour&lt;br/&gt;(lancer, garder des 5, s&#x27;arrêter,&lt;br/&gt;reprendre une main héritée)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="249" width="270" height="62" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="J" target="u4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u7" value="Reprendre une partie en pause" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="321" width="270" height="62" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="J" target="u7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u8" value="Revoir une partie terminée&lt;br/&gt;(rejeu, vitesse, curseur de tour)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="393" width="270" height="62" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=none;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="J" target="u8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u9" value="Consulter la grille&lt;br/&gt;et la courbe des scores" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strok