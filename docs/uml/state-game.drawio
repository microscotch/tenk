<mxfile host="drawio"><diagram name="Page-1" id="d"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Machine à états — cycle de vie d&#x27;une partie (GameEngine)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1200" height="26" as="geometry"/></mxCell><mxCell id="t2" value="Le détail d&#x27;un tour (lancers, garde, craque) est dans turn-state.png. Ici : ce qui se passe entre les tours, le tour final déclenché par le premier 10000 pile, la couronne qui change de main, la pause et l&#x27;archivage." style="text;html=1;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="34" width="1450" height="32" as="geometry"/></mxCell><mxCell id="i" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="24" height="24" as="geometry"/></mxCell><mxCell id="doff" value="&lt;b&gt;Départage&lt;/b&gt;&lt;br/&gt;(state-dice-off.png)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110" y="145" width="170" height="74" as="geometry"/></mxCell><mxCell id="play" value="Jeu normal   (triggeringWinnerIndex = null)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#f5f9ff;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="540" height="250" as="geometry"/></mxCell><mxCell id="choice" value="&lt;b&gt;Choix de main&lt;/b&gt;&lt;br/&gt;activeTurn = null&lt;br/&gt;hériter ou 5 dés neufs ?" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="385" y="140" width="180" height="80" as="geometry"/></mxCell><mxCell id="turn" value="&lt;b&gt;Tour en cours&lt;/b&gt;&lt;br/&gt;activeTurn ≠ null&lt;br/&gt;(voir turn-state.png)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="695" y="140" width="180" height="80" as="geometry"/></mxCell><mxCell id="final" value="Tour final   (triggeringWinnerIndex, remainingFinalTurns)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#f5f9ff;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="450" width="540" height="250" as="geometry"/></mxCell><mxCell id="fchoice" value="&lt;b&gt;Choix de main&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="385" y="530" width="180" height="60" as="geometry"/></mxCell><mxCell id="fturn" value="&lt;b&gt;Tour en cours&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="695" y="530" width="180" height="60" as="geometry"/></mxCell><mxCell id="over" value="&lt;b&gt;Partie terminée&lt;/b&gt;&lt;br/&gt;gameOver, winnerIndex = détenteur" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1020" y="530" width="230" height="70" as="geometry"/></mxCell><mxCell id="arch" value="&lt;b&gt;Archivée&lt;/b&gt;&lt;br/&gt;over/ — rejouable, comptée&lt;br/&gt;dans les statistiques" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1370" y="530" width="200" height="70" as="geometry"/></mxCell><mxCell id="f" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1455" y="690" width="30" height="30" as="geometry"/></mxCell><mxCell id="pause" value="&lt;b&gt;En pause&lt;/b&gt;&lt;br/&gt;in-progress/game-&amp;lt;seed&amp;gt;.run" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="170" width="230" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="i" target="doff"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="startGame(orderedSetup)&lt;br/&gt;/ startTurn : 5 dés" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="doff" target="turn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="70"/><mxPoint x="785" y="70"/></Array></mxGeometry></mxCell><mxCell id="e3" value="startTurn(useFullHand)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="choice" target="turn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="bank() réussi, le suivant hérite&lt;br/&gt;de moins de 5 dés" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="turn" target="choice"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="290"/><mxPoint x="475" y="290"/></Array></mxGeometry></mxCell><mxCell id="e5" value="bank() / endBustedTurn(),&lt;br/&gt;le suivant part à 5 dés" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="turn" target="turn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="180"/><mxPoint x="905" y="120"/><mxPoint x="835" y="120"/></Array></mxGeometry></mxCell><mxCell id="e6" value="fin de tour sur 10000 pile&lt;br/&gt;(y compris quinte d&#x27;as)&lt;br/&gt;/ détenteur = courant, restant = n − 1" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="play" target="final"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="fin de tour d&#x27;un autre sur 10000 pile&lt;br/&gt;/ l&#x27;ancien détenteur est barré,&lt;br/&gt;nouveau détenteur, restant = n − 1" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="final" target="final"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="575"/><mxPoint x="300" y="740"/><mxPoint x="630" y="740"/></Array></mxGeometry></mxCell><mxCell id="e8" value="startTurn" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="fchoice" target="fturn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="bank(), le suivant hérite" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="fturn" target="fchoice"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="650"/><mxPoint x="475" y="650"/></Array></mxGeometry></mxCell><mxCell id="e10" value="fin de tour ≠ 10000&lt;br/&gt;/ restant − 1" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="fturn" target="fturn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="560"/><mxPoint x="905" y="500"/><mxPoint x="835" y="500"/></Array></mxGeometry></mxCell><mxCell id="e11" value="[restant ≤ 0]" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="final" target="over"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="_archiveAndRemove()" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="over" target="arch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="arch" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="l&#x27;app se ferme / retour accueil&lt;br/&gt;(chaque coup est déjà sauvegardé)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="play" target="pause"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="180"/></Array></mxGeometry></mxCell><mxCell id="e15" value="resumeFromSave()&lt;br/&gt;/ replayGame, puis resume" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;rounded=1;" edge="1" parent="1" source="pause" target="play"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1215" y="300"/><mxPoint x="900" y="300"/></Array></mxGeometry></mxCell><mxCell id="n1" value="La pause vaut à tout moment. Pendant le départage, sa reprise&lt;br/&gt;le rouvre là où il en était ; quittée sur son résultat, la partie&lt;br/&gt;reprend avec le premier tour lancé. Ailleurs, la reprise rejoue&lt;br/&gt;le journal et retombe dans le même état." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#fff9c4;strokeColor=#b8a400;" vertex="1" parent="1"><mxGeometry x="1100" y="70" width="360" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
