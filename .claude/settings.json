{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/code-review-trigger.sh",
            "timeout": 10,
            "statusMessage": "Revue de code : vérification du commit..."
          }
        ]
      }
    ]
  }
}
